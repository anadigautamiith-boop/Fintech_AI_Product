{
  "suite": "compile",
  "title": "Mandate to rail blocks",
  "about": "A normalised mandate and a bank profile go in; the rail blocks, the unbacked merchants, the renewals needed and the warnings come out. `bank` is a name from shared.json or an object with maxActiveBlocks. Potential spend is ceil(days / period length) times the period cap, with day = 1, week = 7, month = 30. Warnings are compared as a set; `rules` entries are field:enforcedBy.",
  "cases": [
    { "id": "C01", "group": "blocks", "title": "Two merchants, two blocks of 10,000; 27,000 of potential spend needs two renewals",
      "from": { "base": "M_GROC" }, "bank": "B2",
      "expect": { "days": 60, "potentialSpend": 27000, "blockSize": 10000, "backed": ["freshbasket", "quickmart"], "unbacked": [], "renewalsNeeded": 2, "warnings": ["BLOCK_RENEWALS_NEEDED"],
        "rules": ["merchants:rail+layer", "categories:layer", "perOrderCap:layer", "periodCap:layer", "blockedWeekdays:layer", "askAbove:layer", "duration:rail+layer"] } },
    { "id": "C02", "group": "bank limits", "title": "A bank that allows one block backs only the first merchant",
      "from": { "base": "M_GROC" }, "bank": "B1",
      "expect": { "potentialSpend": 27000, "blockSize": 10000, "backed": ["freshbasket"], "unbacked": ["quickmart"], "renewalsNeeded": 2, "warnings": ["BANK_BLOCK_LIMIT", "BLOCK_RENEWALS_NEEDED"],
        "rules": ["merchants:rail+layer", "merchants:layer", "categories:layer", "perOrderCap:layer", "periodCap:layer", "blockedWeekdays:layer", "askAbove:layer", "duration:rail+layer"] } },
    { "id": "C03", "group": "exposure", "title": "Two blocks of 10,000 against 18,000 of potential spend: the rail allows more than the mandate",
      "from": { "base": "M_FOOD" }, "bank": "B2",
      "expect": { "potentialSpend": 18000, "blockSize": 10000, "backed": ["spiceroute", "biryanilane"], "unbacked": [], "renewalsNeeded": 1, "warnings": ["RAIL_EXPOSURE_EXCEEDS_MANDATE", "BLOCK_RENEWALS_NEEDED"] } },
    { "id": "C04", "group": "blocks", "title": "A small recharge mandate fits inside one block: no warnings",
      "from": { "base": "M_RECHARGE_AUTO" }, "bank": "B2",
      "expect": { "days": 60, "potentialSpend": 1598, "blockSize": 1598, "backed": ["teletop"], "unbacked": [], "renewalsNeeded": 0, "warnings": [],
        "rules": ["merchants:rail+layer", "categories:layer", "perOrderCap:layer", "periodCap:layer", "autoApproveIrreversible:layer", "duration:rail+layer"] } },
    { "id": "C05", "group": "blocks", "title": "No merchant named: no block can be set",
      "from": { "base": "M_ANY" }, "bank": "B2",
      "expect": { "days": 30, "potentialSpend": 25000, "blockSize": null, "backed": [], "unbacked": [], "renewalsNeeded": null, "warnings": ["ANY_MERCHANT_NOT_RAIL_BACKABLE"],
        "rules": ["categories:layer", "perOrderCap:layer", "periodCap:layer", "duration:layer"] } },
    { "id": "C06", "group": "blocks", "title": "A daily cap over 30 days: 15,000 of potential spend, one renewal",
      "from": { "base": "M_DAYCAP" }, "bank": "B2",
      "expect": { "potentialSpend": 15000, "blockSize": 10000, "backed": ["spiceroute"], "unbacked": [], "renewalsNeeded": 1, "warnings": ["BLOCK_RENEWALS_NEEDED"] } },
    { "id": "C07", "group": "exposure", "title": "No period cap: potential spend is unknown and only the 10,000 block limits total spend",
      "from": { "base": "M_GROC", "set": { "periodCap": null } }, "bank": "B2",
      "expect": { "potentialSpend": null, "blockSize": 10000, "backed": ["freshbasket", "quickmart"], "unbacked": [], "renewalsNeeded": null, "warnings": ["NO_PERIOD_CAP"] } },
    { "id": "C08", "group": "exposure", "title": "Block size follows a small period cap, and two blocks exceed it",
      "from": { "base": "M_GROC", "set": { "periodCap": { "amount": 1000, "period": "week" }, "durationDays": 7 } }, "bank": "B2",
      "expect": { "days": 7, "potentialSpend": 1000, "blockSize": 1000, "backed": ["freshbasket", "quickmart"], "unbacked": [], "renewalsNeeded": 0, "warnings": ["RAIL_EXPOSURE_EXCEEDS_MANDATE"] } },
    { "id": "C09", "group": "bank limits", "title": "The merchant listed first gets the block",
      "from": { "base": "M_GROC", "set": { "merchants": ["quickmart", "freshbasket"], "periodCap": { "amount": 3000, "period": "week" }, "durationDays": 7 } }, "bank": "B1",
      "expect": { "potentialSpend": 3000, "blockSize": 3000, "backed": ["quickmart"], "unbacked": ["freshbasket"], "renewalsNeeded": 0, "warnings": ["BANK_BLOCK_LIMIT"] } },
    { "id": "C10", "group": "bank limits", "title": "A bank that allows three blocks backs three shops",
      "from": { "base": "M_GROC", "set": { "merchants": ["freshbasket", "quickmart", "spiceroute"], "categories": null, "periodCap": { "amount": 9000, "period": "week" }, "durationDays": 7 } }, "bank": { "maxActiveBlocks": 3 },
      "expect": { "potentialSpend": 9000, "blockSize": 9000, "backed": ["freshbasket", "quickmart", "spiceroute"], "unbacked": [], "renewalsNeeded": 0, "warnings": ["RAIL_EXPOSURE_EXCEEDS_MANDATE"] } },
    { "id": "C11", "group": "blocks", "title": "A monthly cap over 31 days spans two months: potential spend doubles",
      "from": { "base": "M_GROC", "set": { "periodCap": { "amount": 4000, "period": "month" }, "durationDays": 31 } }, "bank": "B2",
      "expect": { "days": 31, "potentialSpend": 8000, "blockSize": 8000, "backed": ["freshbasket", "quickmart"], "unbacked": [], "renewalsNeeded": 0, "warnings": ["RAIL_EXPOSURE_EXCEEDS_MANDATE"] } },
    { "id": "C12", "group": "blocks", "title": "Potential spend of exactly 10,000 fits one block: no renewals, no warnings",
      "from": { "base": "M_GROC", "set": { "merchants": ["freshbasket"], "periodCap": { "amount": 2500, "period": "week" }, "durationDays": 28 } }, "bank": "B2",
      "expect": { "days": 28, "potentialSpend": 10000, "blockSize": 10000, "backed": ["freshbasket"], "unbacked": [], "renewalsNeeded": 0, "warnings": [] } }
  ]
}
