{
  "suite": "proposal",
  "title": "Agent output to proposal",
  "about": "The shopping agent returns a list of SKUs and quantities. buildProposal derives the merchant from the SKUs and the amount from catalogue prices; it ignores every price, total and merchant the model claims. Errors are compared as a set of codes. Prices: FB-ATTA 285, FB-MILK 56, QM-MILK 58, FK-ATTA 199.",
  "cases": [
    { "id": "B01", "title": "A normal order: merchant from the SKUs, amount from catalogue prices",
      "agentOutput": { "items": [ { "sku": "FB-ATTA", "qty": 1 }, { "sku": "FB-MILK", "qty": 2 } ], "note": "Atta and two litres of milk." },
      "expect": { "ok": true, "errors": [], "merchantId": "freshbasket", "amount": 397, "items": [ { "sku": "FB-ATTA", "qty": 1 }, { "sku": "FB-MILK", "qty": 2 } ] } },
    { "id": "B02", "title": "Prices and totals claimed by the model are ignored",
      "agentOutput": { "items": [ { "sku": "FB-ATTA", "qty": 1, "price": 1, "total": 1 } ], "total": 1, "note": "Total is 1 rupee." },
      "expect": { "ok": true, "errors": [], "merchantId": "freshbasket", "amount": 285 } },
    { "id": "B03", "title": "A merchant or amount claimed at the top level is ignored",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 1 } ], "merchantId": "spiceroute", "amount": 1 },
      "expect": { "ok": true, "errors": [], "merchantId": "freshbasket", "amount": 56 } },
    { "id": "B04", "title": "An unknown SKU is an error",
      "agentOutput": { "items": [ { "sku": "FB-NOPE", "qty": 1 } ] },
      "expect": { "ok": false, "errors": ["UNKNOWN_SKU"] } },
    { "id": "B05", "title": "SKUs from two shops in one order are an error",
      "agentOutput": { "items": [ { "sku": "FB-ATTA", "qty": 1 }, { "sku": "QM-MILK", "qty": 1 } ] },
      "expect": { "ok": false, "errors": ["MIXED_MERCHANTS"] } },
    { "id": "B06", "title": "Quantity zero is an error",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 0 } ] },
      "expect": { "ok": false, "errors": ["BAD_QTY"] } },
    { "id": "B07", "title": "Fractional quantity is an error",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 1.5 } ] },
      "expect": { "ok": false, "errors": ["BAD_QTY"] } },
    { "id": "B08", "title": "Quantity as text is an error",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": "2" } ] },
      "expect": { "ok": false, "errors": ["BAD_QTY"] } },
    { "id": "B09", "title": "100 of one item is over the per-line limit of 99",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 100 } ] },
      "expect": { "ok": false, "errors": ["BAD_QTY"] } },
    { "id": "B10", "title": "99 of one item is accepted",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 99 } ] },
      "expect": { "ok": true, "errors": [], "merchantId": "freshbasket", "amount": 5544 } },
    { "id": "B11", "title": "An empty list is an error",
      "agentOutput": { "items": [] },
      "expect": { "ok": false, "errors": ["NO_ITEMS"] } },
    { "id": "B12", "title": "Output that is not an object is an error",
      "agentOutput": null,
      "expect": { "ok": false, "errors": ["NO_ITEMS"] } },
    { "id": "B13", "title": "Items that are not a list are an error",
      "agentOutput": { "items": { "sku": "FB-MILK", "qty": 1 } },
      "expect": { "ok": false, "errors": ["NO_ITEMS"] } },
    { "id": "B14", "title": "Lines for the same SKU are merged",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 2 } ] },
      "expect": { "ok": true, "errors": [], "merchantId": "freshbasket", "amount": 168, "items": [ { "sku": "FB-MILK", "qty": 3 } ] } },
    { "id": "B15", "title": "The look-alike shop's SKU is built into a proposal; the policy engine is the one that blocks it",
      "agentOutput": { "items": [ { "sku": "FK-ATTA", "qty": 1 } ] },
      "expect": { "ok": true, "errors": [], "merchantId": "freshbaskett", "amount": 199 } },
    { "id": "B16", "title": "SKUs named like object internals are unknown",
      "agentOutput": { "items": [ { "sku": "__proto__", "qty": 1 }, { "sku": "constructor", "qty": 1 } ] },
      "expect": { "ok": false, "errors": ["UNKNOWN_SKU"] } },
    { "id": "B17", "title": "More than 20 lines is an error",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 }, { "sku": "FB-MILK", "qty": 1 } ] },
      "expect": { "ok": false, "errors": ["TOO_MANY_LINES"] } },
    { "id": "B18", "title": "Several problems are reported together",
      "agentOutput": { "items": [ { "sku": "FB-NOPE", "qty": 1 }, { "sku": "FB-MILK", "qty": 0 } ] },
      "expect": { "ok": false, "errors": ["UNKNOWN_SKU", "BAD_QTY"] } },
    { "id": "B19", "title": "A SKU that is not text is unknown",
      "agentOutput": { "items": [ { "sku": 5, "qty": 1 } ] },
      "expect": { "ok": false, "errors": ["UNKNOWN_SKU"] } },
    { "id": "B20", "title": "Lines for one SKU that add up to more than 99 are an error",
      "agentOutput": { "items": [ { "sku": "FB-MILK", "qty": 60 }, { "sku": "FB-MILK", "qty": 60 } ] },
      "expect": { "ok": false, "errors": ["BAD_QTY"] } }
  ]
}
