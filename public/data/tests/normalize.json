{
  "suite": "normalize",
  "title": "Mandate normalisation",
  "about": "Raw mandate in, validated mandate out. `from` builds the raw input from a named mandate in shared.json (`set` overrides fields, `unset` deletes them); `raw` is used as written. Errors are compared as CODE@field and warnings as CODE, ignoring order. `today` defaults to the shared value (2026-11-30, a Monday).",
  "cases": [
    { "id": "N01", "group": "valid", "title": "A complete grocery mandate is accepted without warnings",
      "from": { "base": "M_GROC" },
      "expect": { "ok": true, "errors": [], "warnings": [],
        "mandate": { "merchants": ["freshbasket", "quickmart"], "categories": ["groceries"], "perOrderCap": 1500, "periodCap": { "amount": 3000, "period": "week" }, "blockedWeekdays": ["sat", "sun"], "askAbove": 1000, "autoApproveIrreversible": false, "durationDays": 60, "validFrom": "2026-11-30", "validUntil": "2027-01-28" } } },
    { "id": "N02", "group": "duration", "title": "No duration given: 30 days, with a warning",
      "from": { "base": "M_GROC", "set": { "durationDays": null } },
      "expect": { "ok": true, "errors": [], "warnings": ["DURATION_DEFAULTED"], "mandate": { "durationDays": 30, "validUntil": "2026-12-29" } } },
    { "id": "N03", "group": "duration", "title": "More than 90 days is cut to 90, with a warning",
      "from": { "base": "M_GROC", "set": { "durationDays": 120 } },
      "expect": { "ok": true, "errors": [], "warnings": ["DURATION_CLAMPED"], "mandate": { "durationDays": 90, "validUntil": "2027-02-27" } } },
    { "id": "N04", "group": "merchants", "title": "A shop that is not in the catalogue is an error",
      "from": { "base": "M_GROC", "set": { "merchants": ["nosuchshop"] } },
      "expect": { "ok": false, "errors": ["UNKNOWN_MERCHANT@merchants"], "warnings": [], "mandate": null } },
    { "id": "N05", "group": "merchants", "title": "The unverified look-alike shop is an error",
      "from": { "base": "M_GROC", "set": { "merchants": ["freshbaskett"] } },
      "expect": { "ok": false, "errors": ["MERCHANT_UNVERIFIED@merchants"], "warnings": [], "mandate": null } },
    { "id": "N06", "group": "merchants", "title": "A single string where a list is expected is an error",
      "from": { "base": "M_GROC", "set": { "merchants": "freshbasket" } },
      "expect": { "ok": false, "errors": ["BAD_MERCHANTS@merchants"], "warnings": [], "mandate": null } },
    { "id": "N07", "group": "categories", "title": "An unknown category is an error",
      "from": { "base": "M_GROC", "set": { "categories": ["crypto"] } },
      "expect": { "ok": false, "errors": ["UNKNOWN_CATEGORY@categories"], "warnings": [], "mandate": null } },
    { "id": "N08", "group": "categories", "title": "A single string where a list is expected is an error",
      "from": { "base": "M_GROC", "set": { "categories": "groceries" } },
      "expect": { "ok": false, "errors": ["BAD_CATEGORIES@categories"], "warnings": [], "mandate": null } },
    { "id": "N09", "group": "amounts", "title": "A per-order cap of zero is an error",
      "from": { "base": "M_GROC", "set": { "perOrderCap": 0 } },
      "expect": { "ok": false, "errors": ["BAD_AMOUNT@perOrderCap"], "warnings": [], "mandate": null } },
    { "id": "N10", "group": "amounts", "title": "Each bad amount is reported against its own field",
      "from": { "base": "M_GROC", "set": { "perOrderCap": 1500.5, "periodCap": { "amount": 0, "period": "week" }, "askAbove": "1000" } },
      "expect": { "ok": false, "errors": ["BAD_AMOUNT@perOrderCap", "BAD_AMOUNT@periodCap", "BAD_AMOUNT@askAbove"], "warnings": [], "mandate": null } },
    { "id": "N11", "group": "periods", "title": "An unknown period name is an error",
      "from": { "base": "M_GROC", "set": { "periodCap": { "amount": 3000, "period": "fortnight" } } },
      "expect": { "ok": false, "errors": ["BAD_PERIOD@periodCap"], "warnings": [], "mandate": null } },
    { "id": "N12", "group": "periods", "title": "A period cap written as text is an error",
      "from": { "base": "M_GROC", "set": { "periodCap": "3000/week" } },
      "expect": { "ok": false, "errors": ["BAD_PERIOD@periodCap"], "warnings": [], "mandate": null } },
    { "id": "N13", "group": "weekdays", "title": "An unknown weekday is an error",
      "from": { "base": "M_GROC", "set": { "blockedWeekdays": ["funday"] } },
      "expect": { "ok": false, "errors": ["BAD_WEEKDAY@blockedWeekdays"], "warnings": [], "mandate": null } },
    { "id": "N14", "group": "weekdays", "title": "Blocking all seven days is an error",
      "from": { "base": "M_GROC", "set": { "blockedWeekdays": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } },
      "expect": { "ok": false, "errors": ["ALL_DAYS_BLOCKED@blockedWeekdays"], "warnings": [], "mandate": null } },
    { "id": "N15", "group": "flags", "title": "A flag that is not a boolean is an error",
      "from": { "base": "M_GROC", "set": { "autoApproveIrreversible": "yes" } },
      "expect": { "ok": false, "errors": ["BAD_FLAG@autoApproveIrreversible"], "warnings": [], "mandate": null } },
    { "id": "N16", "group": "duration", "title": "A duration of zero days is an error",
      "from": { "base": "M_GROC", "set": { "durationDays": 0 } },
      "expect": { "ok": false, "errors": ["BAD_DURATION@durationDays"], "warnings": [], "mandate": null } },
    { "id": "N17", "group": "duration", "title": "A fractional duration is an error",
      "from": { "base": "M_GROC", "set": { "durationDays": 2.5 } },
      "expect": { "ok": false, "errors": ["BAD_DURATION@durationDays"], "warnings": [], "mandate": null } },
    { "id": "N18", "group": "duration", "title": "A duration given as text is an error",
      "from": { "base": "M_GROC", "set": { "durationDays": "30" } },
      "expect": { "ok": false, "errors": ["BAD_DURATION@durationDays"], "warnings": [], "mandate": null } },
    { "id": "N19", "group": "warnings", "title": "Ask-above equal to the per-order cap never triggers: warning",
      "from": { "base": "M_GROC", "set": { "askAbove": 1500 } },
      "expect": { "ok": true, "errors": [], "warnings": ["ASK_ABOVE_NOT_BELOW_CAP"] } },
    { "id": "N20", "group": "warnings", "title": "No per-order cap and no period cap: warning",
      "from": { "base": "M_GROC", "set": { "perOrderCap": null, "periodCap": null } },
      "expect": { "ok": true, "errors": [], "warnings": ["NO_SPEND_CAP"] } },
    { "id": "N21", "group": "warnings", "title": "Per-order cap above the period cap: warning",
      "from": { "base": "M_GROC", "set": { "perOrderCap": 5000, "periodCap": { "amount": 4000, "period": "week" } } },
      "expect": { "ok": true, "errors": [], "warnings": ["ORDER_CAP_ABOVE_PERIOD_CAP"] } },
    { "id": "N22", "group": "warnings", "title": "A named shop outside the allowed categories: warning",
      "from": { "base": "M_GROC", "set": { "merchants": ["freshbasket", "spiceroute"] } },
      "expect": { "ok": true, "errors": [], "warnings": ["MERCHANT_OUTSIDE_CATEGORIES"] } },
    { "id": "N23", "group": "cleaning", "title": "Duplicates are removed, first-seen order is kept, weekdays come out in week order",
      "from": { "base": "M_GROC", "set": { "merchants": ["quickmart", "freshbasket", "quickmart"], "blockedWeekdays": ["sun", "sat", "sat"] } },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "merchants": ["quickmart", "freshbasket"], "blockedWeekdays": ["sat", "sun"] } } },
    { "id": "N24", "group": "cleaning", "title": "Empty lists mean 'none named' and become null",
      "from": { "base": "M_GROC", "set": { "merchants": [], "categories": [] } },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "merchants": null, "categories": null } } },
    { "id": "N25", "group": "cleaning", "title": "Unknown fields are dropped, not copied",
      "from": { "base": "M_GROC", "set": { "admin": true, "approveEverything": true } },
      "expect": { "ok": true, "errors": [], "warnings": [],
        "mandateKeys": ["askAbove", "autoApproveIrreversible", "blockedWeekdays", "categories", "durationDays", "merchants", "perOrderCap", "periodCap", "validFrom", "validUntil"] } },
    { "id": "N26", "group": "cleaning", "title": "An empty object gets defaults and the matching warnings",
      "raw": {},
      "expect": { "ok": true, "errors": [], "warnings": ["NO_SPEND_CAP", "DURATION_DEFAULTED"],
        "mandate": { "merchants": null, "categories": null, "perOrderCap": null, "periodCap": null, "blockedWeekdays": [], "askAbove": null, "autoApproveIrreversible": false, "durationDays": 30 } } },
    { "id": "N27", "group": "errors", "title": "Several errors are reported together",
      "from": { "base": "M_GROC", "set": { "merchants": ["nosuchshop"], "durationDays": 0, "periodCap": { "amount": 100, "period": "year" } } },
      "expect": { "ok": false, "errors": ["UNKNOWN_MERCHANT@merchants", "BAD_DURATION@durationDays", "BAD_PERIOD@periodCap"], "warnings": [], "mandate": null } },
    { "id": "N28", "group": "amounts", "title": "1,000,000 is the largest accepted amount",
      "from": { "base": "M_GROC", "set": { "perOrderCap": 1000000 } },
      "expect": { "ok": true, "errors": [], "warnings": ["ORDER_CAP_ABOVE_PERIOD_CAP"] } },
    { "id": "N29", "group": "amounts", "title": "1,000,001 is rejected",
      "from": { "base": "M_GROC", "set": { "perOrderCap": 1000001 } },
      "expect": { "ok": false, "errors": ["BAD_AMOUNT@perOrderCap"], "warnings": [], "mandate": null } },
    { "id": "N30", "group": "periods", "title": "A daily cap equal to the per-order cap is accepted without warnings",
      "from": { "base": "M_DAYCAP" },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "periodCap": { "amount": 500, "period": "day" } } } },
    { "id": "N31", "group": "dates", "title": "A one-day mandate ends the day it starts",
      "from": { "base": "M_GROC", "set": { "durationDays": 1 } },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "validFrom": "2026-11-30", "validUntil": "2026-11-30" } } },
    { "id": "N32", "group": "dates", "title": "The end date crosses a year boundary",
      "today": "2026-12-31", "from": { "base": "M_GROC", "set": { "durationDays": 2 } },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "validFrom": "2026-12-31", "validUntil": "2027-01-01" } } },
    { "id": "N33", "group": "dates", "title": "The end date handles a leap day",
      "today": "2028-02-28", "from": { "base": "M_GROC", "set": { "durationDays": 3 } },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "validFrom": "2028-02-28", "validUntil": "2028-03-01" } } },
    { "id": "N34", "group": "duration", "title": "Exactly 90 days is kept as it is, with no warning",
      "from": { "base": "M_GROC", "set": { "durationDays": 90 } },
      "expect": { "ok": true, "errors": [], "warnings": [], "mandate": { "durationDays": 90, "validUntil": "2027-02-27" } } },
    { "id": "N35", "group": "duration", "title": "91 days is cut to 90, with a warning",
      "from": { "base": "M_GROC", "set": { "durationDays": 91 } },
      "expect": { "ok": true, "errors": [], "warnings": ["DURATION_CLAMPED"], "mandate": { "durationDays": 90, "validUntil": "2027-02-27" } } }
  ]
}
