{
  "suite": "shadow",
  "title": "Shadow mode and the promotion gate",
  "about": "Gate cases give event counts per segment and ask whether the agent may move up a rung. The override rate must be strictly below 10%, every segment needs at least 50 events, and a segment below the minimum is reported as INSUFFICIENT_DATA only. Failures are compared as CODE or CODE@segment, ignoring order. Generated cases use the seeded synthetic generator; the data is invented and says nothing about real users. The sample counts in S01 and S02 are shaped like the book's MoneyGro example (a healthy-looking overall rate hiding one weak segment); they are not its figures.",
  "threshold": 0.1,
  "minEvents": 50,
  "cases": [
    { "id": "S01", "type": "gate", "title": "Overall 8.6% looks fine, but the family segment is at 26%: promotion is refused",
      "input": { "from": "approve_each", "weeks": 8, "consent": true,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 39 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": false, "to": null, "failures": ["SEGMENT_OVER_THRESHOLD@family"], "overall": { "events": 720, "overrides": 62, "rate": 0.0861 } } },
    { "id": "S02", "type": "gate", "title": "Every segment under 10%, 8 weeks, consent given: move to bounded",
      "input": { "from": "approve_each", "weeks": 8, "consent": true,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": true, "to": "bounded", "failures": [], "overall": { "events": 720, "overrides": 32, "rate": 0.0444 } } },
    { "id": "S03", "type": "gate", "title": "Good evidence but no consent: bounded needs the person's say-so",
      "input": { "from": "approve_each", "weeks": 8, "consent": false,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": false, "to": null, "failures": ["NO_CONSENT"] } },
    { "id": "S04", "type": "gate", "title": "A segment with 30 events is not enough data",
      "input": { "from": "approve_each", "weeks": 8, "consent": true,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 30, "overrides": 1 } } },
      "expect": { "allowed": false, "to": null, "failures": ["INSUFFICIENT_DATA@new_user"] } },
    { "id": "S05", "type": "gate", "title": "A segment below the minimum is reported as insufficient data only, even if its rate is high",
      "input": { "from": "approve_each", "weeks": 8, "consent": true,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 30, "overrides": 20 } } },
      "expect": { "allowed": false, "to": null, "failures": ["INSUFFICIENT_DATA@new_user"] } },
    { "id": "S06", "type": "gate", "title": "Three weeks of shadow data is too short for suggest to approve_each",
      "input": { "from": "suggest", "weeks": 3, "consent": false,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": false, "to": null, "failures": ["TOO_SHORT"] } },
    { "id": "S07", "type": "gate", "title": "Four weeks is enough for suggest to approve_each, and consent is not required for that step",
      "input": { "from": "suggest", "weeks": 4, "consent": false,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": true, "to": "approve_each", "failures": [] } },
    { "id": "S08", "type": "gate", "title": "Seven weeks is too short for approve_each to bounded",
      "input": { "from": "approve_each", "weeks": 7, "consent": true,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": false, "to": null, "failures": ["TOO_SHORT"] } },
    { "id": "S09", "type": "gate", "title": "bounded is the top rung: nothing to promote to",
      "input": { "from": "bounded", "weeks": 8, "consent": true,
        "segments": { "single": { "events": 250, "overrides": 8 }, "couple": { "events": 180, "overrides": 8 }, "family": { "events": 150, "overrides": 9 }, "new_user": { "events": 140, "overrides": 7 } } },
      "expect": { "allowed": false, "to": null, "failures": ["TOP_RUNG"] } },
    { "id": "S10", "type": "gate", "title": "A segment at exactly 10% fails: the rate must be below 10%",
      "input": { "from": "suggest", "weeks": 4, "consent": false,
        "segments": { "single": { "events": 100, "overrides": 10 }, "couple": { "events": 100, "overrides": 4 }, "family": { "events": 100, "overrides": 6 }, "new_user": { "events": 100, "overrides": 5 } } },
      "expect": { "allowed": false, "to": null, "failures": ["SEGMENT_OVER_THRESHOLD@single"], "overall": { "events": 400, "overrides": 25, "rate": 0.0625 } } },
    { "id": "S11", "type": "gate", "title": "The same segment at 9% passes",
      "input": { "from": "suggest", "weeks": 4, "consent": false,
        "segments": { "single": { "events": 100, "overrides": 9 }, "couple": { "events": 100, "overrides": 4 }, "family": { "events": 100, "overrides": 6 }, "new_user": { "events": 100, "overrides": 5 } } },
      "expect": { "allowed": true, "to": "approve_each", "failures": [] } },
    { "id": "S12", "type": "gate", "title": "Every segment at exactly 10%: the overall rate fails too",
      "input": { "from": "suggest", "weeks": 4, "consent": false,
        "segments": { "single": { "events": 100, "overrides": 10 }, "couple": { "events": 100, "overrides": 10 }, "family": { "events": 100, "overrides": 10 }, "new_user": { "events": 100, "overrides": 10 } } },
      "expect": { "allowed": false, "to": null, "failures": ["OVERALL_OVER_THRESHOLD", "SEGMENT_OVER_THRESHOLD@single", "SEGMENT_OVER_THRESHOLD@couple", "SEGMENT_OVER_THRESHOLD@family", "SEGMENT_OVER_THRESHOLD@new_user"], "overall": { "events": 400, "overrides": 40, "rate": 0.1 } } },
    { "id": "S13", "type": "determinism", "title": "The generator gives the same events for the same seed and different events for another seed",
      "generate": { "set": "hidden_gap", "seed": 7, "weeks": 8, "eventsPerWeek": 250 }, "otherSeed": 8 },
    { "id": "S14", "type": "generated", "title": "Hidden-gap set: overall rate under 10%, family segment over 10%, promotion refused",
      "generate": { "set": "hidden_gap", "seed": 7, "weeks": 8, "eventsPerWeek": 250 },
      "gate": { "from": "approve_each", "consent": true },
      "expect": { "events": 2000, "weeks": 8, "overallBetween": [0.065, 0.098], "segmentBetween": { "family": [0.18, 0.34] }, "allowed": false, "failures": ["SEGMENT_OVER_THRESHOLD@family"] } },
    { "id": "S15", "type": "generated", "title": "Healthy set with the same seed: promotion allowed",
      "generate": { "set": "healthy", "seed": 7, "weeks": 8, "eventsPerWeek": 250 },
      "gate": { "from": "approve_each", "consent": true },
      "expect": { "events": 2000, "weeks": 8, "overallBetween": [0.03, 0.07], "segmentBetween": { "family": [0.02, 0.099] }, "allowed": true, "to": "bounded", "failures": [] } }
  ]
}
