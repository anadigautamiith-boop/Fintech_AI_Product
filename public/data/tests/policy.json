      "proposal": { "merchantId": "freshbasket", "amount": 10000 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "perOrderCap": null, "period": { "kind": null, "cap": null }, "rail": { "limit": 10000, "remainingAfter": 0 } } } },
    { "id": "P056", "group": "rail", "title": "No caps at all: one rupee more than the block is blocked by the rail",
      "mandateRaw": { "merchants": ["freshbasket"], "categories": null, "perOrderCap": null, "periodCap": null, "blockedWeekdays": [], "askAbove": null, "autoApproveIrreversible": false, "durationDays": 30 },
      "proposal": { "merchantId": "freshbasket", "amount": 10001 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["RAIL_BLOCK_EXHAUSTED"] } },

    { "id": "P057", "group": "soft", "title": "Same merchant and amount 20 minutes ago: possible duplicate",
