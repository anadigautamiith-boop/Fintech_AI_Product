    { "id": "P058", "group": "soft", "title": "Duplicate window includes exactly 30 minutes",
      "ledger": [ { "merchantId": "freshbasket", "amount": 600, "ts": "2026-12-01T09:30:00+05:30" } ],
      "proposal": { "merchantId": "freshbasket", "amount": 600 },
      "expect": { "verdict": "ask", "outcome": "awaiting_approval", "reasons": ["ASK_POSSIBLE_DUPLICATE"] } },
