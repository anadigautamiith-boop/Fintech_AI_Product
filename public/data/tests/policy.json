      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "rail": { "remainingBefore": 500, "remainingAfter": 0 } } } },
    { "id": "P050", "group": "rail", "title": "Rail use is gross: a refunded order does not give the block back",
      "ledger": [ { "merchantId": "quickmart", "amount": 1000, "ts": "2026-11-30T11:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1000, "ts": "2026-11-30T13:00:00+05:30", "status": "refunded" } ],
      "railUsed": { "quickmart": 9500 }, "proposal": { "merchantId": "quickmart", "amount": 600 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["RAIL_BLOCK_EXHAUSTED"] } },
