{
  "suite": "policy",
  "title": "Policy engine",
  "about": "Each case gives a mandate, a bank profile, a clock, a ledger and a proposal, and states the verdict, outcome and reason codes the spec requires. Defaults: mandate M_GROC, bank B2, rung bounded, now Tuesday 2026-12-01 10:00 IST. Ledger entries default to status paid; rail use defaults to the gross sum of the ledger. Cases with `steps` run in order and carry state forward.",
  "defaults": { "mandate": "M_GROC", "bank": "B2", "rung": "bounded", "now": "2026-12-01T10:00:00+05:30" },
  "cases": [
    { "id": "P001", "group": "basics", "title": "Order inside every limit is allowed and executed",
      "proposal": { "merchantId": "freshbasket", "amount": 900 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [],
        "figures": { "amount": 900, "merchantName": "FreshBasket", "category": "groceries", "perOrderCap": 1500, "askAbove": 1000,
          "period": { "kind": "week", "cap": 3000, "spentBefore": 0, "remainingBefore": 3000, "remainingAfter": 2100 },
          "rail": { "limit": 10000, "used": 0, "remainingBefore": 10000, "remainingAfter": 9100 },
          "undo": { "reversible": true, "windowMin": 15 } } } },
    { "id": "P002", "group": "basics", "title": "Above ask-above but under the cap: ask the person",
      "proposal": { "merchantId": "freshbasket", "amount": 1200 },
      "expect": { "verdict": "ask", "outcome": "awaiting_approval", "reasons": ["ASK_ABOVE_THRESHOLD"] } },
    { "id": "P003", "group": "basics", "title": "Exactly ask-above is not above it: allowed",
      "proposal": { "merchantId": "freshbasket", "amount": 1000 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P004", "group": "basics", "title": "Exactly the per-order cap is allowed to proceed (as an ask)",
      "proposal": { "merchantId": "freshbasket", "amount": 1500 },
      "expect": { "verdict": "ask", "outcome": "awaiting_approval", "reasons": ["ASK_ABOVE_THRESHOLD"] } },
    { "id": "P005", "group": "basics", "title": "One rupee over the per-order cap is blocked",
      "proposal": { "merchantId": "freshbasket", "amount": 1501 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["OVER_ORDER_CAP"] } },
    { "id": "P006", "group": "basics", "title": "Second listed merchant is allowed",
      "proposal": { "merchantId": "quickmart", "amount": 900 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P007", "group": "basics", "title": "Merchant and category outside the mandate: both reasons, in order",
      "proposal": { "merchantId": "spiceroute", "amount": 300 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MERCHANT_NOT_ALLOWED", "CATEGORY_NOT_ALLOWED"] } },
    { "id": "P008", "group": "basics", "title": "Look-alike merchant (unverified) is blocked and no figures are produced",
      "proposal": { "merchantId": "freshbaskett", "amount": 300 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MERCHANT_UNVERIFIED"], "figures": null } },
    { "id": "P009", "group": "basics", "title": "Merchant not in the catalogue is blocked as unverified",
      "proposal": { "merchantId": "nosuchshop", "amount": 300 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MERCHANT_UNVERIFIED"], "figures": null } },

    { "id": "P010", "group": "time", "title": "Saturday is a blocked day",
      "now": "2026-12-05T10:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["BLOCKED_DAY"] } },
    { "id": "P011", "group": "time", "title": "Sunday is a blocked day",
      "now": "2026-12-06T10:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["BLOCKED_DAY"] } },
    { "id": "P012", "group": "time", "title": "Friday 23:59:59 IST is still Friday: allowed",
      "now": "2026-12-04T23:59:59+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P013", "group": "time", "title": "Saturday 00:00:00 IST is Saturday even though it is Friday in UTC",
      "now": "2026-12-05T00:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["BLOCKED_DAY"] } },
    { "id": "P014", "group": "time", "title": "Monday 00:00:00 IST is Monday even though it is Sunday in UTC",
      "now": "2026-12-07T00:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P015", "group": "time", "title": "A clock given in UTC is converted to IST: 19:00Z on Friday is 00:30 on Saturday",
      "now": "2026-12-04T19:00:00Z", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["BLOCKED_DAY"] } },
    { "id": "P016", "group": "time", "title": "Last second of the mandate is still valid",
      "now": "2027-01-28T23:59:59+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P017", "group": "time", "title": "First second after the mandate is expired",
      "now": "2027-01-29T00:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MANDATE_EXPIRED"], "figures": null } },
    { "id": "P018", "group": "time", "title": "First second of the mandate is valid",
      "now": "2026-11-30T00:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P019", "group": "time", "title": "One second before the mandate starts: not started (and the blocked-day check is not reached)",
      "now": "2026-11-29T23:59:59+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MANDATE_NOT_STARTED"], "figures": null } },
    { "id": "P020", "group": "time", "title": "Paused mandate blocks an otherwise fine order",
      "paused": true, "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MANDATE_PAUSED"], "figures": null } },
    { "id": "P021", "group": "time", "title": "Paused is reported before expired",
      "paused": true, "now": "2027-02-01T10:00:00+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MANDATE_PAUSED"], "figures": null } },

    { "id": "P083", "group": "time", "title": "The last millisecond of the mandate is still valid",
      "now": "2027-01-28T23:59:59.999+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P084", "group": "time", "title": "The last millisecond before the mandate starts is too early",
      "now": "2026-11-29T23:59:59.999+05:30", "proposal": { "merchantId": "freshbasket", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["MANDATE_NOT_STARTED"], "figures": null } },

    { "id": "P022", "group": "invalid", "title": "Zero amount is an invalid proposal",
      "proposal": { "merchantId": "freshbasket", "amount": 0 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P023", "group": "invalid", "title": "Negative amount is an invalid proposal",
      "proposal": { "merchantId": "freshbasket", "amount": -500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P024", "group": "invalid", "title": "Paise (999.99) are not accepted in v1",
      "proposal": { "merchantId": "freshbasket", "amount": 999.99 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P025", "group": "invalid", "title": "Amount as a string is invalid",
      "proposal": { "merchantId": "freshbasket", "amount": "500" },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P026", "group": "invalid", "title": "Null amount is invalid",
      "proposal": { "merchantId": "freshbasket", "amount": null },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P027", "group": "invalid", "title": "Missing merchant is invalid",
      "proposal": { "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P028", "group": "invalid", "title": "Empty merchant id is invalid",
      "proposal": { "merchantId": "", "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P029", "group": "invalid", "title": "Merchant id that is a number is invalid",
      "proposal": { "merchantId": 123, "amount": 500 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P030", "group": "invalid", "title": "Amount beyond the safe integer range (1e21) is invalid",
      "proposal": { "merchantId": "freshbasket", "amount": 1e21 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P031", "group": "invalid", "title": "A null proposal does not crash the engine",
      "proposal": null,
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P032", "group": "invalid", "title": "A proposal that is free text instead of an object is invalid",
      "proposal": "pay 500 to freshbasket",
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },
    { "id": "P033", "group": "invalid", "title": "Invalid proposal is reported before paused",
      "paused": true, "proposal": { "merchantId": "freshbasket", "amount": 0 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["INVALID_PROPOSAL"], "figures": null } },

    { "id": "P034", "group": "period", "title": "Week total lands exactly on the cap: allowed",
      "ledger": [ { "merchantId": "freshbasket", "amount": 1000, "ts": "2026-11-30T11:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1000, "ts": "2026-11-30T13:00:00+05:30" } ],
      "proposal": { "merchantId": "freshbasket", "amount": 1000 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "period": { "spentBefore": 2000, "remainingBefore": 1000, "remainingAfter": 0 } } } },
    { "id": "P035", "group": "period", "title": "One rupee over the week cap is blocked (and the ask-above reason is suppressed)",
      "ledger": [ { "merchantId": "freshbasket", "amount": 1000, "ts": "2026-11-30T11:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1000, "ts": "2026-11-30T13:00:00+05:30" } ],
      "proposal": { "merchantId": "freshbasket", "amount": 1001 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["OVER_PERIOD_CAP"] } },
    { "id": "P036", "group": "period", "title": "A full week blocks even a small order",
      "ledger": [ { "merchantId": "freshbasket", "amount": 1500, "ts": "2026-11-30T11:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1500, "ts": "2026-11-30T13:00:00+05:30" } ],
      "proposal": { "merchantId": "quickmart", "amount": 100 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["OVER_PERIOD_CAP"] } },
    { "id": "P037", "group": "period", "title": "The next Monday starts a fresh week",
      "now": "2026-12-07T10:00:00+05:30",
      "ledger": [ { "merchantId": "freshbasket", "amount": 1500, "ts": "2026-11-30T11:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1500, "ts": "2026-11-30T13:00:00+05:30" } ],
      "proposal": { "merchantId": "quickmart", "amount": 900 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "period": { "spentBefore": 0 } } } },
    { "id": "P038", "group": "period", "title": "A refunded order does not count toward the period cap",
      "ledger": [ { "merchantId": "freshbasket", "amount": 1000, "ts": "2026-11-30T11:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1000, "ts": "2026-11-30T13:00:00+05:30" }, { "merchantId": "quickmart", "amount": 1000, "ts": "2026-11-30T14:00:00+05:30", "status": "refunded" } ],
      "proposal": { "merchantId": "freshbasket", "amount": 1000 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "period": { "spentBefore": 2000 } } } },
    { "id": "P039", "group": "period", "title": "Week boundary is Monday 00:00 IST, not UTC: Sunday night spend does not count",
      "mandate": "M_PLAIN", "now": "2026-12-07T00:30:00+05:30",
      "ledger": [ { "merchantId": "freshbasket", "amount": 3500, "ts": "2026-12-06T22:00:00+05:30" } ],
      "proposal": { "merchantId": "freshbasket", "amount": 3500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "period": { "spentBefore": 0 } } } },
    { "id": "P040", "group": "period", "title": "Day boundary is midnight IST, not UTC: yesterday's spend does not count",
      "mandate": "M_DAYCAP", "now": "2026-12-02T00:10:00+05:30",
      "ledger": [ { "merchantId": "spiceroute", "amount": 400, "ts": "2026-12-01T22:30:00+05:30" } ],
      "proposal": { "merchantId": "spiceroute", "amount": 400 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [], "figures": { "period": { "kind": "day", "spentBefore": 0 } } } },
    { "id": "P041", "group": "period", "title": "Daily cap exceeded by one rupee",
      "mandate": "M_DAYCAP",
      "ledger": [ { "merchantId": "spiceroute", "amount": 300, "ts": "2026-12-01T08:00:00+05:30" } ],
      "proposal": { "merchantId": "spiceroute", "amount": 201 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["OVER_PERIOD_CAP"] } },
    { "id": "P042", "group": "period", "title": "The next day the daily cap resets",
      "mandate": "M_DAYCAP", "now": "2026-12-02T10:00:00+05:30",
      "ledger": [ { "merchantId": "spiceroute", "amount": 300, "ts": "2026-12-01T08:00:00+05:30" } ],
      "proposal": { "merchantId": "spiceroute", "amount": 500 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P043", "group": "period", "title": "Monthly cap reached exactly: allowed",
      "mandate": "M_RECHARGE_AUTO", "now": "2026-12-10T10:00:00+05:30",
      "ledger": [ { "merchantId": "teletop", "amount": 399, "ts": "2026-12-02T10:00:00+05:30" } ],
      "proposal": { "merchantId": "teletop", "amount": 400 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [],
        "figures": { "period": { "kind": "month", "cap": 799, "spentBefore": 399, "remainingBefore": 400, "remainingAfter": 0 }, "rail": { "limit": 1598, "used": 399, "remainingBefore": 1199, "remainingAfter": 799 }, "undo": { "reversible": false, "windowMin": 0 } } } },
    { "id": "P044", "group": "period", "title": "Monthly cap exceeded by one rupee",
      "mandate": "M_RECHARGE_AUTO", "now": "2026-12-10T10:00:00+05:30",
      "ledger": [ { "merchantId": "teletop", "amount": 399, "ts": "2026-12-02T10:00:00+05:30" } ],
      "proposal": { "merchantId": "teletop", "amount": 401 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["OVER_PERIOD_CAP"] } },
    { "id": "P045", "group": "period", "title": "A new month resets the period but not the rail block",
      "mandate": "M_RECHARGE_AUTO", "now": "2027-01-05T10:00:00+05:30",
      "ledger": [ { "merchantId": "teletop", "amount": 799, "ts": "2026-12-20T10:00:00+05:30" } ],
      "proposal": { "merchantId": "teletop", "amount": 799 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [],
        "figures": { "period": { "spentBefore": 0 }, "rail": { "limit": 1598, "used": 799, "remainingBefore": 799, "remainingAfter": 0 } } } },
    { "id": "P046", "group": "period", "title": "Food mandate: weekly total lands exactly on 2,000",
      "mandate": "M_FOOD",
      "ledger": [ { "merchantId": "spiceroute", "amount": 800, "ts": "2026-11-30T12:00:00+05:30" }, { "merchantId": "biryanilane", "amount": 800, "ts": "2026-11-30T19:00:00+05:30" } ],
      "proposal": { "merchantId": "spiceroute", "amount": 400 },
      "expect": { "verdict": "allow", "outcome": "executed", "reasons": [] } },
    { "id": "P047", "group": "period", "title": "Food mandate: one rupee over the weekly total",
      "mandate": "M_FOOD",
      "ledger": [ { "merchantId": "spiceroute", "amount": 800, "ts": "2026-11-30T12:00:00+05:30" }, { "merchantId": "biryanilane", "amount": 800, "ts": "2026-11-30T19:00:00+05:30" } ],
      "proposal": { "merchantId": "spiceroute", "amount": 401 },
      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["OVER_PERIOD_CAP"] } },

    { "id": "P048", "group": "rail", "title": "Order larger than what is left on the merchant's block is blocked",
