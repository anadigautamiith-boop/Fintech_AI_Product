      "expect": { "verdict": "block", "outcome": "blocked", "reasons": ["RAIL_BLOCK_EXHAUSTED"], "figures": { "rail": { "limit": 10000, "used": 9500, "remainingBefore": 500, "remainingAfter": 0 } } } },
    { "id": "P049", "group": "rail", "title": "Order exactly equal to what is left on the block is allowed",
